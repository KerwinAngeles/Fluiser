VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Web Push VAPID keys — generate your own with:
#   node -e "const c=require('crypto');const{publicKey,privateKey}=c.generateKeyPairSync('ec',{namedCurve:'prime256v1'});const pj=publicKey.export({format:'jwk'});const pk=privateKey.export({format:'jwk'});const b=s=>Buffer.from(s,'base64url');const raw=Buffer.concat([Buffer.from([4]),b(pj.x),b(pj.y)]);console.log('VITE_VAPID_PUBLIC_KEY='+raw.toString('base64url'));console.log('VAPID_PRIVATE_KEY='+pk.d);"
# VITE_VAPID_PUBLIC_KEY is safe to expose to the client (used by pushManager.subscribe).
# VAPID_PRIVATE_KEY must stay server-side only (Supabase Edge Function secret) — never prefix it with VITE_.
VITE_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
