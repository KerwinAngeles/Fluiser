# Local dev only (`supabase functions serve --env-file supabase/functions/send-push/.env`).
# In production these are set with `supabase secrets set --env-file ...` or
# `supabase secrets set VAPID_PUBLIC_KEY=... VAPID_PRIVATE_KEY=... VAPID_SUBJECT=...`.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by the platform
# (and by the CLI locally) — do not set them here.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@fluiser.app
